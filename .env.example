# ---------- App ----------
APP_ENV=dev
HTTP_ADDR=:8080
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (CSV)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting
FORM_RATE_PER_HOUR=10
API_RATE_PER_MIN=120

# ---------- Database ----------
DATABASE_URL=postgres://timemachine:timemachine@localhost:5432/timemachine?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_MAX_IDLE_TIME=15m

# ---------- Admin / JWT ----------
# Use a long random string in production (>= 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_TTL=12h
JWT_ISSUER=timemachine

# Default seed admin (migration 0002):
#   email:    admin@timemachine.ru
#   password: admin12345   <-- REPLACE BEFORE PRODUCTION

# ---------- MAX messenger ----------
MAX_ENABLED=false            # set true once a real bot token is configured
MAX_API_TOKEN=               # bot token issued by MAX / @BotMaster
MAX_API_BASE=https://botapi.max.ru
MAX_BOT_HANDLE=@timemachine_bot
MAX_DEEPLINK_PREFIX=https://max.ru/
MAX_WEBHOOK_SECRET=          # shared secret used to validate inbound webhook
MAX_NOTIFY_CHAT_ID=          # admin chat/room to receive new leads & appointments

# ---------- AI agent ----------
AI_ENABLED=false             # set true to enable LLM layer (rule layer always runs)
AI_PROVIDER=stub             # stub | openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=600